# Environment variables for CarbonSight

# Django settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# AI Integration (Multiple Options)

# Option 1: Local AI with Ollama (FREE, runs offline)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b
# Install: brew install ollama && ollama pull mistral:7b

# Option 2: OpenAI (requires API key and credits)
OPENAI_API_KEY=your-openai-api-key-here
# Get your API key from: https://platform.openai.com/api-keys

# Option 3: Hugging Face (free tier available)
HUGGINGFACE_API_KEY=your-hf-api-key-here
# Get your API key from: https://huggingface.co/settings/tokens

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carbonsight
# Or individual database settings:
# DB_NAME=carbonsight
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Azure (for production)
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
# AZURE_STORAGE_CONTAINER_NAME=
